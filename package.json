{
  "name": "Kilonova",
  "version": "1.0.0",
  "description": "A minimal personal startpage built with Svelte and TailwindCSS",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
